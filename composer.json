{
    "name": "jeffersongoncalves/laravel-g2",
    "description": "A Laravel client for the G2 API — reviews, products, reports, competitors, categories, and tracking events.",
    "keywords": [
        "laravel",
        "g2",
        "reviews",
        "saas",
        "api",
        "client"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "jefferson@codions.com",
            "homepage": "https://github.com/jeffersongoncalves"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.14.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\G2\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\G2\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\G2\\G2ServiceProvider"
            ],
            "aliases": {
                "G2": "JeffersonGoncalves\\G2\\Facades\\G2"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
